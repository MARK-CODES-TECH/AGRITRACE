# ═════════════════════════════════════════════════════════════
# AgriTrace+ Configuration File
# Copy this file to .env and fill in your actual credentials.
# ═════════════════════════════════════════════════════════════

# ── Database Settings ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=myproject4
DB_USER=root
DB_PASS=
# Optional: force specific port (defaults to checking 3306 then 3307)
# DB_PORT=3307

# ── Gmail SMTP Settings (For OTP & Email Notifications) ──────
# Note: Google requires a 16-character App Password (not your normal account password).
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_NAME="AgriTrace+"

# ── Twilio SMS Settings (Optional - For SMS OTP) ─────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
